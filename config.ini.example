# Пример конфигурационного файла для приложения "Военкомат"
# Скопируйте этот файл в config.ini и укажите свои параметры подключения

[Database]
# Хост базы данных (обычно localhost)
host=localhost

# Порт базы данных (обычно 5432 для PostgreSQL)
port=5432

# Имя базы данных
database=voenkomat

# Имя пользователя
username=postgres

# Пароль НЕ хранится в этом файле!
# Используйте системную переменную окружения PGPASSWORD
# В PowerShell: $env:PGPASSWORD = "ваш_пароль"
# В CMD: set PGPASSWORD=ваш_пароль

